<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(NO_BEPINEX_CORE_DIR)</BepInExCoreDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Mono.Cecil"><HintPath>$(BepInExCoreDir)/Mono.Cecil.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <Target Name="CheckCecil" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(BepInExCoreDir)/Mono.Cecil.dll')" Text="Set NO_BEPINEX_CORE_DIR or BepInExCoreDir to matching BepInEx core references." />
  </Target>
</Project>
