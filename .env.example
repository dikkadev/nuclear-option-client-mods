# Copy this file to `.env` at the workspace root and set paths for this machine.
# `.env` is ignored because these paths point at local game/mod-manager installs.

# Steam library root in WSL/Linux form. Regular non-VR installs derive from this.
STEAMAPPS_DIR="/mnt/path/to/SteamLibrary/steamapps"

# Regular Nuclear Option install.
GAME_DIR="$STEAMAPPS_DIR/common/Nuclear Option"
GAME_BEPINEX_DIR="$GAME_DIR/BepInEx"
GAME_BEPINEX_PLUGINS_DIR="$GAME_BEPINEX_DIR/plugins"
GAME_BEPINEX_CONFIG_DIR="$GAME_BEPINEX_DIR/config"
NO_MANAGED_DIR="$GAME_DIR/NuclearOption_Data/Managed"
NO_BEPINEX_CORE_DIR="$GAME_BEPINEX_DIR/core"

# Default build configuration for most local installs.
BUILD_CONFIGURATION="Release"
